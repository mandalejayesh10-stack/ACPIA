{
  "name": "@acpia/ai-provider",
  "version": "0.1.0",
  "private": true,
  "description": "ACPIA — Unified AI Provider Layer: reason(), vision(), ocr(), speech(), embed() (Sprint 17-18)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
