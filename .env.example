# ACPIA Environment Variables Template
# Copy this file to .env before starting services with Docker Compose
# DO NOT COMMIT REAL SECRETS TO GIT

# ─── API & Web ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
JWT_SECRET=super-secret-acpia-jwt-key-change-in-production-min-32-chars

# ─── PostgreSQL 16 ───────────────────────────────────────────────────────────
POSTGRES_USER=acpia_admin
POSTGRES_PASSWORD=acpia_secure_password_2026
POSTGRES_DB=acpia_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://acpia_admin:acpia_secure_password_2026@localhost:5432/acpia_db?schema=public

# ─── Neo4j 5 Knowledge Graph ──────────────────────────────────────────────────
NEO4J_AUTH=neo4j/acpia_neo4j_password_2026
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687

# ─── Redis 7 ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=acpia_redis_password_2026
REDIS_PORT=6379
REDIS_URL=redis://:acpia_redis_password_2026@localhost:6379/0

# ─── RabbitMQ 3 Event Bus ─────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=acpia_bus
RABBITMQ_DEFAULT_PASS=acpia_rabbitmq_password_2026
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://acpia_bus:acpia_rabbitmq_password_2026@localhost:5672

# ─── Qdrant Vector Search ─────────────────────────────────────────────────────
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# ─── MinIO Evidence File Storage ──────────────────────────────────────────────
MINIO_ROOT_USER=acpia_minio_admin
MINIO_ROOT_PASSWORD=acpia_minio_password_2026
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_BUCKET_EVIDENCE=acpia-evidence

# ─── Elasticsearch 8 ──────────────────────────────────────────────────────────
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200

# ─── AI Provider Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-placeholder-replace-with-real-key
ANTHROPIC_API_KEY=sk-ant-placeholder
